<Project>

  <!--
    ┌─────────────────────────────────────────────────────────────────────────┐
    │  Jewelix.Orchestrator — NuGet package configuration                             │
    │                                                                         │
    │  All packaging metadata lives here so the version and identity of this  │
    │  package can be managed independently of the shared Directory.Build.props│
    │  that applies to every project in the solution.                         │
    │                                                                         │
    │  To release a new version:                                              │
    │    1. Bump <Version> below.                                             │
    │    2. Commit and push to main.                                          │
    │    3. Push a matching tag:  git tag v<Version> && git push origin v...  │
    │    The CI/CD pipeline (.github/workflows/cicd-orchestrator.yml) picks up the   │
    │    tag, rebuilds with -p:Version=<tag>, packs, and publishes.           │
    └─────────────────────────────────────────────────────────────────────────┘
  -->

  <PropertyGroup>

    <!-- ── Identity ─────────────────────────────────────────────────────── -->
    <PackageId>Jewelix.Orchestrator</PackageId>
    <Title>Jewelix CQRS</Title>
    <Description>
      Lightweight, zero-dependency CQRS orchestrator for Jewelix services.
      Provides command, query, and domain-event dispatch with a composable
      pipeline-behavior model. Drop-in replacement for MediatR with
      assembly-scanning registration via AddJewelixOrchestrator.
    </Description>
    <Authors>Achi054</Authors>
    <Copyright>Copyright © 2024 Achi054</Copyright>

    <!-- ── Version ──────────────────────────────────────────────────────── -->
    <!--   Overridden by CI via  -p:Version=$(git-tag)  on tagged releases.  -->
    <Version>1.0.0</Version>

    <!-- ── Discovery ────────────────────────────────────────────────────── -->
    <PackageTags>orchestrator;orchestrator;commands;queries;events;pipeline;aspnetcore;jewelix</PackageTags>

    <!-- ── Licensing &amp; source ────────────────────────────────────────── -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/Achi054/Library.Jewelix.Infrastructure</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Achi054/Library.Jewelix.Infrastructure</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- ── Presentation ─────────────────────────────────────────────────── -->
    <PackageIcon>Jewelix-logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- ── Symbols ──────────────────────────────────────────────────────── -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

  </PropertyGroup>

  <!-- ── Package contents ───────────────────────────────────────────────── -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)Jewelix-logo.png"
          Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md"
          Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
